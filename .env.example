# CyberGenetic Gym — Environment Configuration
# Copy to .env and adjust for your environment.

# Application
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://cybergen:cybergen@localhost:5432/cybergennet

# Security
SECRET_KEY=change-this-in-production

# Gym defaults
GYM_DEFAULT_DIVISION=CORE
GYM_DEFAULT_TIER=T3
GYM_MAX_CREDENTIAL_LEVEL=6

# Evaluator
EVALUATOR_MIN_CONFIDENCE=0.7
EVALUATOR_REQUIRE_MULTI=false

# Genetic Engine
GENETIC_POPULATION_SIZE=50
GENETIC_ELITE_RATIO=0.2
GENETIC_MUTATION_RATE=0.15
GENETIC_CROSSOVER_RATE=0.7
GENETIC_DIVERSITY_PRESSURE=0.15

# Security
DEFAULT_DENY_NETWORK=true
ATHLETE_WORKSPACE_ISOLATION=true
